{
  "name": "messagecounter",
  "version": "1.0.0",
  "author": "小张",
  "description": "插上 U 盘五分钟,解决你一天的统计工作量",
  "main": "main.js",
  "dependencies": {
    "antd": "^5.20.5"
  },
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  },
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --win",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.messagecounter.app",
    "productName": "聊天数据管家",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.icns",
      "identity": null

    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "public/",
        "to": "public",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
