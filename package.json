{
  "name": "messagecounter",
  "version": "3.0.0",
  "author": "小张",
  "description": "插上 U 盘五分钟,解决你一天的统计工作量",
  "main": "main.js",
  "dependencies": {
    "antd": "^5.20.5",
    "electron-updater": "^6.3.9",
    "sharp": "^0.34.4",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  },
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --win",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "postinstall": "electron-builder install-app-deps",
    "license:list-usb": "node scripts/license-tools.js list-usb",
    "license:machine-fingerprint": "node scripts/license-tools.js machine-fingerprint",
    "license:issue": "node scripts/license-tools.js issue-license",
    "license:issue-offline": "node scripts/license-tools.js issue-offline",
    "license:issue-to-usb": "node scripts/license-tools.js issue-to-usb",
    "license:wizard": "node scripts/license-tools.js issue-wizard",
    "license:studio": "electron scripts/license-studio/main.js",
    "license:studio:dist": "electron-builder --config scripts/license-studio/builder.config.json",
    "license:studio:dist:dir": "electron-builder --config scripts/license-studio/builder.config.json --dir",
    "license:studio:dist:mac": "electron-builder --config scripts/license-studio/builder.config.json --mac zip",
    "license:studio:dist:mac:dmg": "electron-builder --config scripts/license-studio/builder.config.json --mac dmg",
    "license:studio:dist:win": "electron-builder --config scripts/license-studio/builder.config.json --win nsis"
  },
  "build": {
    "appId": "com.messagecounter.app",
    "productName": "聊天数据管家",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon.icns",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "public/",
        "to": "public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "keys/",
        "to": "keys",
        "filter": [
          "license-public.pem"
        ]
      },
      {
        "from": "assets/ocr/",
        "to": "ocr",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}
