{
  "name": "messagecounter",
  "version": "6.0.5",
  "author": "小张",
  "description": "一款支持内置书库与本地 TXT 导入的离线小说阅读器",
  "main": "main.js",
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "electron-updater": "^6.3.9",
    "sharp": "^0.34.4",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^27.3.11",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  },
  "engines": {
    "node": "18.x"
  },
  "overrides": {
    "cross-spawn": "7.0.6",
    "form-data": "4.0.5",
    "js-yaml": "4.1.1",
    "config-file-ts": {
      "glob": "10.5.0"
    },
    "onnxruntime-node": {
      "tar": "7.5.11"
    }
  },
  "scripts": {
    "start": "electron .",
    "dist": "npm run dist:mac && npm run dist:win",
    "dist:win": "node scripts/run-electron-builder.js --with-ai-models --win nsis",
    "dist:mac": "node scripts/run-electron-builder.js --with-ai-models --mac dmg",
    "dist:slim": "npm run dist:mac:slim && npm run dist:win:slim",
    "dist:win:slim": "node scripts/run-electron-builder.js --win nsis",
    "dist:mac:slim": "node scripts/run-electron-builder.js --mac dmg",
    "dist:full": "npm run dist",
    "dist:win:full": "npm run dist:win",
    "dist:mac:full": "npm run dist:mac",
    "postinstall": "electron-builder install-app-deps",
    "license:list-usb": "node scripts/license-tools.js list-usb",
    "license:machine-fingerprint": "node scripts/license-tools.js machine-fingerprint",
    "license:issue": "node scripts/license-tools.js issue-license",
    "license:issue-offline": "node scripts/license-tools.js issue-offline",
    "license:issue-to-usb": "node scripts/license-tools.js issue-to-usb",
    "license:wizard": "node scripts/license-tools.js issue-wizard",
    "license:studio": "electron scripts/license-studio/main.js",
    "parser:dataset-blocks": "node scripts/check-message-dataset-blocks.js",
    "license:studio:dist": "electron-builder --config scripts/license-studio/builder.config.json",
    "license:studio:dist:dir": "electron-builder --config scripts/license-studio/builder.config.json --dir",
    "license:studio:dist:mac": "electron-builder --config scripts/license-studio/builder.config.json --mac zip",
    "license:studio:dist:mac:dmg": "electron-builder --config scripts/license-studio/builder.config.json --mac dmg",
    "license:studio:dist:win": "electron-builder --config scripts/license-studio/builder.config.json --win nsis"
  }
}
